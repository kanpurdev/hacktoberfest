{
  "name": "code-roaster-workspace",
  "displayName": "Code Roaster 🔥",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "code-roaster"
  ],
  "bin": {
    "code-roaster": "./cli.js"
  },
  "scripts": {
    "start": "node ./cli.js",
    "compile": "npm --prefix code-roaster run compile",
    "watch": "npm --prefix code-roaster run watch",
    "build": "npm --prefix code-roaster run build",
    "package": "npm --prefix code-roaster run package",
    "typecheck": "npm --prefix code-roaster run typecheck",
    "test": "npm --prefix code-roaster run test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "dependencies": {
    "openai": "^4.0.0"
  }
}
